<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"[1] Aktywuj Rozwiązywanie Państwa Gracza & Osiągnięć (CGameState / CAchievementsManager)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
luaCall(function()
  local base = getAddressSafe("hoi4.exe")
  if not base then error("Nie znaleziono procesu hoi4.exe!") end
  unregisterSymbol("pPlayerCountry")
  unregisterSymbol("pPlayerPolitical")
  unregisterSymbol("pPlayerFuel")
  unregisterSymbol("pPlayerNukes")
  unregisterSymbol("pPlayerXP")
  unregisterSymbol("pAchievementsManager")
  registerSymbol("pPlayerCountry", allocateMemory(8))
  registerSymbol("pPlayerPolitical", allocateMemory(8))
  registerSymbol("pPlayerFuel", allocateMemory(8))
  registerSymbol("pPlayerNukes", allocateMemory(8))
  registerSymbol("pPlayerXP", allocateMemory(8))
  registerSymbol("pAchievementsManager", allocateMemory(8))

  if PlayerResolverTimer then PlayerResolverTimer.destroy() end
  PlayerResolverTimer = createTimer(nil, true)
  PlayerResolverTimer.Interval = 250
  PlayerResolverTimer.OnTimer = function()
    local b = getAddressSafe("hoi4.exe")
    if not b then return end
    local gs = readQword(b + 0x33DD6B0)
    local achMgr = readQword(b + 0x33DE950)
    if achMgr and achMgr ~= 0 then
      writeQword("pAchievementsManager", achMgr)
    end
    if not gs or gs == 0 then return end
    local tag = readInteger(gs + 0x520)
    if not tag or tag <= 0 then tag = readInteger(gs + 0x524) end
    if not tag or tag <= 0 then return end
    local tag2idx = readQword(gs + 0x340)
    if not tag2idx or tag2idx == 0 then return end
    local cidx = readInteger(tag2idx + tag * 4)
    if not cidx or cidx < 0 then return end
    local carr = readQword(gs + 0x310)
    if not carr or carr == 0 then return end
    local ccountry = readQword(carr + cidx * 8)
    if not ccountry or ccountry == 0 then return end

    writeQword("pPlayerCountry", ccountry)
    writeQword("pPlayerPolitical", readQword(ccountry + 0xF90) or 0)
    writeQword("pPlayerNukes", readQword(ccountry + 0x1310) or 0)
    writeQword("pPlayerFuel", readQword(ccountry + 0x1580) or 0)
    writeQword("pPlayerXP", readQword(ccountry + 0x1588) or 0)
  end
end)

[DISABLE]
luaCall(function()
  if PlayerResolverTimer then
    PlayerResolverTimer.destroy()
    PlayerResolverTimer = nil
  end
end)
</AssemblerScript>
